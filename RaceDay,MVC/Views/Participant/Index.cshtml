@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container mt-5 mb-5">

    <div class="card shadow-sm mb-4 overflow-hidden">
        <div class="row g-0 align-items-center">

            <div class="col-md-7">
                <div class="card-body p-4 p-md-5">
                    <h1 class="display-6 fw-bold">Welcome to RaceDay!</h1>

                    <p class="lead mb-0">
                        Discover events, track your enrolments and celebrate your results.
                    </p>
                </div>
            </div>

            <div class="col-md-5">
                <img src="~/images/events/types/walk.jpg"
                     alt="Participants enjoying a walking event"
                     class="img-fluid w-100"
                     style="height: 230px; object-fit: cover;" />
            </div>

        </div>
    </div>

    <h2 class="h4 mb-3">Your RaceDay</h2>

    <div class="row g-4">

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <img src="~/images/events/types/run.jpg"
                     alt="Running event"
                     class="card-img-top"
                     style="height: 150px; object-fit: cover;" />

                <div class="card-body">
                    <h3 class="h5 card-title">Upcoming Events</h3>

                    <p class="card-text">
                        Find running, walking and cycling events to join.
                    </p>

                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-primary">
                        Browse Events
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <img src="~/images/events/types/cycle.jpg"
                     alt="Cycling event"
                     class="card-img-top"
                     style="height: 150px; object-fit: cover;" />

                <div class="card-body">
                    <h3 class="h5 card-title">My Enrolments</h3>

                    <p class="card-text">
                        Check the events you have enrolled in and their status.
                    </p>

                    <a asp-controller="Participant"
                       asp-action="MyEnrolments"
                       class="btn btn-primary">
                        View My Enrolments
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <img src="~/images/events/types/placeholder.jpg"
                     alt="Race results"
                     class="card-img-top"
                     style="height: 150px; object-fit: cover;" />

                <div class="card-body">
                    <h3 class="h5 card-title">My Results</h3>

                    <p class="card-text">
                        Review your race times and finishing positions.
                    </p>
                    <a asp-controller="Participant"
                       asp-action="MyResults"
                       class="btn btn-primary">
                        View My Results
                    </a>
                </div>
            </div>
        </div>
        @*profile can now be accessed from the nav bar links*@
</div>
    </div>
</div>
