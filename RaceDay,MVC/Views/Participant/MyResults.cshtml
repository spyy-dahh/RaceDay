@model List<RaceDay.MVC.Models.MyResultViewModel>

@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-4">

    <h2>My Results</h2>

    <p class="text-muted">
        View your finishing positions and times for completed events.
    </p>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    else if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You don't have any recorded results yet.
        </div>
    }

    else
    {
        <div class="table-responsive mt-3">

            <table class="table table-striped table-bordered">

                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Category</th>
                        <th>Position</th>
                        <th>Finish Time</th>
                        <th>Result Date</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var result in Model)
                    {
                        <tr>
                            <td>@result.EventName</td>
                            <td>@result.CategoryName</td>
                            <td>@result.Position</td>
                            <td>@result.FinishTime.ToString(@"hh\:mm\:ss")</td>
                            <td>@result.DateOfResults.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }

    <a asp-controller="Participant"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>

</div>