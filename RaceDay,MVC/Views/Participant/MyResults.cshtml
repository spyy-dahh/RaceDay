
@model List<RaceDay.MVC.Models.MyResultViewModel>

@{
    ViewData["Title"] = "My Results";

    // Adds the correct suffix to a finishing position.
    string GetOrdinalSuffix(int position)
    {
        int lastTwoDigits = position % 100;

        if (lastTwoDigits >= 11 && lastTwoDigits <= 13)
        {
            return "th";
        }

        switch (position % 10)
        {
            case 1:
                return "st";
            case 2:
                return "nd";
            case 3:
                return "rd";
            default:
                return "th";
        }
    }
}

<div class="container mt-4">
    <h2>My Results</h2>

    <p class="text-muted">
        View your finishing positions and times for completed events.
    </p>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }
    else if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You don't have any recorded results yet.
        </div>
    }
    else
    {
        <div class="table-responsive mt-3">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Event Date</th>
                        <th>Category</th>
                        <th>Position</th>
                        <th>Finish Time</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in Model)
                    {
                        <tr>
                            <td>@result.EventName</td>
                            <td>@result.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@result.CategoryName</td>
                            <td>
                                @(result.Position)@(GetOrdinalSuffix(result.Position))
                                of @result.TotalParticipants
                            </td>
                            <td>@result.FinishTime</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Participant" asp-action="Index"
       class="btn btn-secondary mt-3">Back to Dashboard</a>
</div>
