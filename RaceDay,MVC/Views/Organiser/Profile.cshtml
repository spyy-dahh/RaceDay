 @model RaceDay.MVC.Models.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-5 mb-5">

    <div class="mb-4">
        <h1 class="display-6 fw-bold">My Profile</h1>
        <p class="text-muted">
            View your RaceDay organiser account information.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <!-- Profile picture -->
            <div class="text-center mb-4">

                <h5 class="fw-bold mb-3">Profile Picture</h5>

                <img src="@Url.Action("ProfileImage", "Organiser")"
                     alt="Organiser Profile Picture"
                     class="rounded-circle border mb-3"
                     style="width: 150px; height: 150px; object-fit: cover;"
                     onerror="this.style.display='none';" />

                <p class="text-muted small">
                    Upload a JPG, JPEG, PNG or WEBP image (maximum 5 MB).
                </p>

                <form asp-controller="Organiser"
                      asp-action="UploadProfileImage"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <input type="file"
                               name="image"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp"
                               required />
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Upload Profile Picture
                    </button>

                </form>

            </div>

            <hr class="my-4" />

            <!-- Account information -->
            <div class="mb-4">
                <label class="form-label fw-semibold">Username</label>
                <p class="form-control bg-light">@Model.UserName</p>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Email Address</label>
                <p class="form-control bg-light">@Model.EmailAddress</p>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Contact Number</label>
                <p class="form-control bg-light">@Model.ContactNumber</p>
            </div>

            <div class="d-flex gap-2">
                <a asp-controller="Organiser"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back to Dashboard
                </a>
            </div>

        </div>
    </div>

</div>