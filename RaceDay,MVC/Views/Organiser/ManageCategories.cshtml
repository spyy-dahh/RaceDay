@model List<RaceDay.MVC.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
}

<div class="container mt-5 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Manage Categories</h1>
            <p class="text-muted mb-0">
                Manage the categories for this event.
            </p>
        </div>

        <a asp-controller="Organiser"
           asp-action="CreateCategory"
           asp-route-id="@ViewBag.EventId"
           class="btn btn-primary">
            Add Category
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            This event doesn't have any categories yet.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var category in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h5 class="card-title">
                                @category.CategoryName
                            </h5>

                            <p>
                                <strong>Distance:</strong>
                                @(category.Distance ?? "Not specified")
                            </p>

                            <p>
                                <strong>Age Range:</strong>
                                @(category.AgeRange ?? "Not specified")
                            </p>

                            <hr />

                            <a asp-controller="Organiser"
                               asp-action="EditCategory"
                               asp-route-id="@category.CategoryId"
                               asp-route-eventId="@ViewBag.EventId"
                               class="btn btn-outline-primary btn-sm">
                                Edit
                            </a>

                            <form asp-controller="Organiser"
                                  asp-action="DeleteCategory"
                                  asp-route-id="@category.CategoryId"
                                  asp-route-eventId="@ViewBag.EventId"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to delete this category?');">

                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    Delete
                                </button>

                            </form>

                        </div>
                    </div>
                </div>
            }

        </div>
    }

    <div class="mt-4">
        <a asp-controller="Organiser"
           asp-action="MyEvents"
           class="btn btn-outline-secondary">
            Back to My Events
        </a>
    </div>

</div>