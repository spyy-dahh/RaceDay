
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-5 mb-5">

    <div class="card shadow-sm mb-4 overflow-hidden">
        <div class="row g-0 align-items-center">

            <div class="col-md-7">
                <div class="card-body p-4 p-md-5">
                    <h1 class="display-6 fw-bold">Organiser Dashboard</h1>

                    <p class="lead mb-0">
                        Manage your events and help keep RaceDay running smoothly.
                    </p>
                </div>
            </div>

            <div class="col-md-5">
                <img src="~/images/events/types/run.jpg"
                     alt="Running event"
                     class="img-fluid w-100"
                     style="height: 230px; object-fit: cover;" />
            </div>

        </div>
    </div>

    <h2 class="h4 mb-3">Event Management</h2>

    <div class="row g-4">

        <!-- Browse Events -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                 <img src="~/images/events/types/run.jpg"
                     alt="Running events"
                     class="card-img-top"
                     style="height: 150px; object-fit: cover;" />

                <div class="card-body">
                    <h3 class="h5 card-title">Browse Events</h3>

                    <p class="card-text">
                        View the events currently available on RaceDay.
                    </p>

                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-primary">
                        View Events
                    </a>
                </div>
            </div>
        </div>

        <!-- Create and Manage Events -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                 <img src="~/images/events/types/walk.jpg"
                     alt="Running events"
                     class="card-img-top"
                     style="height: 150px; object-fit: cover;" />

                <div class="card-body">
                    <h3 class="h5 card-title">Manage My Events</h3>

                    <p class="card-text">
                        Create, update, delete and manage your events.
                    </p>

                    <a asp-controller="Organiser"
                       asp-action="MyEvents"
                       class="btn btn-primary">
                        View My Events
                    </a>
                </div>
            </div>
        </div>

        <!-- Manage Enrolments -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                 <img src="~/images/events/types/run.jpg"
                     alt="Running events"
                     class="card-img-top"
                     style="height: 150px; object-fit: cover;" />

                <div class="card-body">
                    <h3 class="h5 card-title">Manage Enrolments</h3>

                    <p class="card-text">
                        View participants enrolled in your events.
                    </p>

                    <a asp-controller="Organiser"
                       asp-action="ManageEnrolments"
                       class="btn btn-primary">
                        View Enrolments
                    </a>
                </div>
            </div>
        </div>

        <!-- Manage Categories -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                 <img src="~/images/events/types/cycle.jpg"
                     alt="Running events"
                     class="card-img-top"
                     style="height: 150px; object-fit: cover;" />

                <div class="card-body">
                    <h3 class="h5 card-title">Manage Categories</h3>

                    <p class="card-text">
                        Create, update and delete categories for your events.
                    </p>

                    <a asp-controller="Organiser"
                       asp-action="MyEvents"
                       class="btn btn-primary">
                        Manage Categories
                    </a>
                </div>
            </div>
        </div>

        <!-- Race Results -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                 <img src="~/images/events/types/walk.jpg"
                     alt="Running events"
                     class="card-img-top"
                     style="height: 150px; object-fit: cover;" />

                <div class="card-body">
                    <h3 class="h5 card-title">Race Results</h3>

                    <p class="card-text">
                        View event enrolments and record participants' race results.
                    </p>

                    <a asp-controller="Organiser"
                       asp-action="ManageEnrolments"
                       class="btn btn-primary">
                        Manage Results
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>
