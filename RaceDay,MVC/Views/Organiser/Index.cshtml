
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-5 mb-5">

    <div class="p-4 p-md-5 mb-4 bg-light rounded-3">
        <h1 class="display-6 fw-bold">Organiser Dashboard</h1>

        <p class="lead mb-0">
            Manage your events and help keep RaceDay running smoothly.
        </p>
    </div>

    <h2 class="h4 mb-3">Event Management</h2>

    <div class="row g-4">

        <!-- Browse Events -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="h5 card-title">Browse Events</h3>

                    <p class="card-text">
                        View the events currently available on RaceDay.
                    </p>

                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-primary">
                        View Events
                    </a>
                </div>
            </div>
        </div>

        <!-- Create and Manage Events -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="h5 card-title">Manage My Events</h3>

                    <p class="card-text">
                        Create, update, delete and manage your events.
                    </p>

                    <a asp-controller="Organiser"
                       asp-action="MyEvents"
                       class="btn btn-primary">
                        View My Events
                    </a>
                </div>
            </div>
        </div>

        <!-- Manage Enrolments -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="h5 card-title">Manage Enrolments</h3>

                    <p class="card-text">
                        View participants enrolled in your events.
                    </p>

                    <a asp-controller="Organiser"
                       asp-action="ManageEnrolments"
                       class="btn btn-primary">
                        View Enrolments
                    </a>
                </div>
            </div>
        </div>

        <!-- Manage Categories -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="h5 card-title">Manage Categories</h3>

                    <p class="card-text">
                        Create, update and delete categories for your events.
                    </p>

                    <a asp-controller="Organiser"
                       asp-action="MyEvents"
                       class="btn btn-primary">
                        Manage Categories
                    </a>
                </div>
            </div>
        </div>

        <!-- Race Results -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="h5 card-title">Race Results</h3>

                    <p class="card-text">
                        View event enrolments and record participants' race results.
                    </p>

                    <a asp-controller="Organiser"
                       asp-action="ManageEnrolments"
                       class="btn btn-primary">
                        Manage Results
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>
