@model List<RaceDay.MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-5 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">My Events</h1>
            <p class="text-muted mb-0">
                Manage the events you have organised.
            </p>
        </div>

        <a asp-controller="Organiser"
           asp-action="CreateEvent"
           class="btn btn-primary">
            Create New Event
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            You haven't created any events yet.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var eventItem in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <span class="badge text-bg-primary mb-2">
                                @eventItem.EventType
                            </span>

                            <h5 class="card-title">
                                @eventItem.EventName
                            </h5>

                            <p class="card-text text-muted">
                                @eventItem.Description
                            </p>

                            <hr />

                            <p>
                                <strong>Date:</strong>
                                @eventItem.EventDate.ToString("dd MMM yyyy")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @eventItem.Location
                            </p>

                            <p>
                                <strong>Distance:</strong>
                                @eventItem.Distance km
                            </p>

                        </div>

                    </div>
                </div>
            }

        </div>
    }

    <div class="mt-4">
        <a asp-controller="Organiser"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

</div>