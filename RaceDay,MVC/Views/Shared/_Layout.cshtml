<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay_MVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>

        @{
            // Get the role of the currently logged-in user.
            var userRole = Context.Session.GetString("UserRole");
        }

        <nav class="navbar navbar-expand-lg navbar-dark raceday-navbar">
            <div class="container">

                <!-- Website Brand -->
                <a class="navbar-brand fw-bold"
                   asp-controller="@(userRole == "Organiser" ? "Organiser" : userRole == "Participant" ? "Participant" : "Account")"
                   asp-action="@(userRole == "Organiser" || userRole == "Participant" ? "Index" : "Register")">
                    RaceDay
                </a>

                <!-- Mobile Navigation Button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <!-- Main Navigation Links -->
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2">

                        <li class="nav-item">
                            <a class="nav-link nav-link-box"
                               asp-controller="Events"
                               asp-action="Index">
                                Events
                            </a>
                        </li>

                        @if (userRole == "Organiser")
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-box"
                                   asp-controller="Organiser"
                                   asp-action="Index">
                                    Dashboard
                                </a>
                            </li>
                        }
                        else if (userRole == "Participant")
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-box"
                                   asp-controller="Participant"
                                   asp-action="Index">
                                    Dashboard
                                </a>
                            </li>

                        }

                        @if (userRole == "Participant")
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-box"
                                   asp-controller="Participant"
                                   asp-action="Profile">
                                    My Profile(Participant)
                                </a>

                                                        <!-- Profile picture and username -->
                        @if (userRole == "Participant" || userRole == "Organiser")
                        {
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center gap-2"
                                   asp-controller="@(userRole == "Participant" ? "Participant" : "Organiser")"
                                   asp-action="Profile">

                                    <img src="@(userRole == "Participant"
                                        ? Url.Action("ProfileImage", "Participant")
                                        : Url.Action("ProfileImage", "Organiser"))"
                                         alt="Profile Picture"
                                         class="rounded-circle border"
                                         style="width: 38px; height: 38px; object-fit: cover;"
                                         onerror="this.style.display='none';" />

                                    <span class="fw-semibold">
                                        @Context.Session.GetString("UserName")
                                    </span>

                                </a>
                            </li>
                        }
                            </li>
                        }
                        else if (userRole == "Organiser")
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-box"
                                   asp-controller="Organiser"
                                   asp-action="Profile">
                                    My Profile(Organiser)
                                </a>

                                                        <!-- Profile picture and username -->
                        @if (userRole == "Participant" || userRole == "Organiser")
                        {
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center gap-2"
                                   asp-controller="@(userRole == "Participant" ? "Participant" : "Organiser")"
                                   asp-action="Profile">

                                    <img src="@(userRole == "Participant"
                                        ? Url.Action("ProfileImage", "Participant")
                                        : Url.Action("ProfileImage", "Organiser"))"
                                         alt="Profile Picture"
                                         class="rounded-circle border"
                                         style="width: 38px; height: 38px; object-fit: cover;"
                                         onerror="this.style.display='none';" />

                                    <span class="fw-semibold">
                                        @Context.Session.GetString("UserName")
                                    </span>

                                </a>
                            </li>
                        }
                            </li>
                        }

                        <!-- Login / Register for logged-out users -->
                        @if (userRole != "Organiser" && userRole != "Participant")
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-box"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Register
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link nav-link-box"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Log In
                                </a>
                            </li>
                        }

                        <!-- Logout for logged-in users -->
                        @if (userRole == "Organiser" || userRole == "Participant")
                        {
                            <li class="nav-item">
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-light btn-sm logout-button">
                                        Log Out
                                    </button>

                                </form>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>

    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RaceDay - 
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>